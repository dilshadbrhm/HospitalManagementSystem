@model HospitalManagement.Domain.Entities.Blog
@{
    ViewData["Title"] = "Edit Blog Post";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="fas fa-edit"></i> Edit Blog Post</h4>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label><i class="fas fa-heading"></i> Title <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control form-control-lg" value="@Model.Title" required />
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-align-left"></i> Short Description</label>
                        <textarea name="ShortDescription" class="form-control" rows="3">@Model.ShortDescription</textarea>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-file-alt"></i> Content <span class="text-danger">*</span></label>
                        <textarea name="Content" class="form-control" rows="10" required>@Model.Content</textarea>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-header">
                            <strong><i class="fas fa-cog"></i> Post Settings</strong>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label><i class="fas fa-folder"></i> Category <span class="text-danger">*</span></label>
                                <select name="CategoryId" class="form-control" required>
                                    <option value="">-- Select Category --</option>
                                    @if (ViewBag.Categories != null)
                                    {
                                        foreach (var item in ViewBag.Categories as Microsoft.AspNetCore.Mvc.Rendering.SelectList)
                                        {
                                            if (item.Value == Model.CategoryId.ToString())
                                            {
                                                <option value="@item.Value" selected>@item.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>

                            <div class="form-group">
                                <label><i class="fas fa-user"></i> Author Name</label>
                                <input type="text" name="AuthorName" class="form-control" value="@Model.AuthorName" />
                            </div>

                            <div class="form-group">
                                <label><i class="fas fa-image"></i> Featured Image</label>
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <div class="mb-2">
                                        <img src="@Model.ImageUrl" alt="Current Image" class="img-fluid rounded" style="max-height: 150px;" />
                                    </div>
                                }
                                <input type="file" name="image" class="form-control-file" accept="image/*" />
                                <small class="text-muted">Leave empty to keep current image</small>
                            </div>

                            <div class="form-group">
                                <div class="custom-control custom-switch">
                                    <input type="checkbox" name="IsPublished" value="true" class="custom-control-input" id="isPublished" @(Model.IsPublished ? "checked" : "") />
                                    <label class="custom-control-label" for="isPublished">
                                        <i class="fas fa-globe"></i> Published
                                    </label>
                                </div>
                            </div>

                            <hr />

                            <div class="small text-muted">
                                <p class="mb-1"><i class="fas fa-eye"></i> Views: <strong>@Model.ViewCount</strong></p>
                                <p class="mb-1"><i class="fas fa-calendar"></i> Published: <strong>@Model.PublishedDate.ToString("dd MMM yyyy")</strong></p>
                                <p class="mb-0"><i class="fas fa-link"></i> Slug: <strong>@Model.Slug</strong></p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-success btn-block">
                            <i class="fas fa-save"></i> Update Blog Post
                        </button>
                        <a href="/Blog/Details/@Model.Slug" target="_blank" class="btn btn-outline-info btn-block">
                            <i class="fas fa-external-link-alt"></i> View Post
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-block">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>