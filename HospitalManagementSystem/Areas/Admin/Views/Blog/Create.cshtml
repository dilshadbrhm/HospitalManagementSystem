@model HospitalManagement.Domain.Entities.Blog
@{
    ViewData["Title"] = "Create Blog Post";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="fas fa-plus-circle"></i> Create Blog Post</h4>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label><i class="fas fa-heading"></i> Title <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control form-control-lg" placeholder="Enter blog title" value="@Model?.Title" required />
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-align-left"></i> Short Description</label>
                        <textarea name="ShortDescription" class="form-control" rows="3" placeholder="Brief summary of the post...">@Model?.ShortDescription</textarea>
                        <small class="text-muted">This will appear in blog listings</small>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-file-alt"></i> Content <span class="text-danger">*</span></label>
                        <textarea name="Content" class="form-control" rows="10" placeholder="Write your blog content here..." required>@Model?.Content</textarea>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-header">
                            <strong><i class="fas fa-cog"></i> Post Settings</strong>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label><i class="fas fa-folder"></i> Category <span class="text-danger">*</span></label>
                                <select name="CategoryId" class="form-control" required>
                                    <option value="">-- Select Category --</option>
                                    @if (ViewBag.Categories != null)
                                    {
                                        foreach (var item in ViewBag.Categories as Microsoft.AspNetCore.Mvc.Rendering.SelectList)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="form-group">
                                <label><i class="fas fa-user"></i> Author Name</label>
                                <input type="text" name="AuthorName" class="form-control" placeholder="Author name" value="@Model?.AuthorName" />
                            </div>

                            <div class="form-group">
                                <label><i class="fas fa-image"></i> Featured Image</label>
                                <input type="file" name="image" class="form-control-file" accept="image/*" />
                                <small class="text-muted">Recommended: 800x400 pixels</small>
                            </div>

                            <div class="form-group">
                                <div class="custom-control custom-switch">
                                    <input type="checkbox" name="IsPublished" value="true" class="custom-control-input" id="isPublished" checked />
                                    <label class="custom-control-label" for="isPublished">
                                        <i class="fas fa-globe"></i> Publish immediately
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary btn-block">
                            <i class="fas fa-save"></i> Save Blog Post
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-block">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>