@model HospitalManagement.Domain.Patient
@{
    ViewData["Title"] = "Patient Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <h4>Patient Details</h4>
    </div>
</div>

<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <table class="table">
                    <tr>
                        <th>Name</th>
                        <td>@Model.FirstName @Model.LastName</td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td>@Model.Email</td>
                    </tr>
                    <tr>
                        <th>Phone</th>
                        <td>@Model.Phone</td>
                    </tr>
                    <tr>
                        <th>Date of Birth</th>
                        <td>@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd.MM.yyyy") : "-")</td>
                    </tr>
                    <tr>
                        <th>Address</th>
                        <td>@(Model.Address ?? "-")</td>
                    </tr>
                </table>

                <a asp-action="Patients" class="btn btn-secondary">Back</a>
            </div>
        </div>
    </div>
</div>