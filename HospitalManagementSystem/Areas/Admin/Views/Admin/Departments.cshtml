@model List<HospitalManagement.Application.Dtos.Department.DepartmentDto>
@{
    ViewData["Title"] = "Departments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="d-flex justify-content-between">
            <h4>All Departments</h4>
            <a asp-action="CreateDepartment" class="btn btn-primary">Add New Department</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var department in Model)
                            {
                                <tr>
                                    <td>@department.Name</td>
                                    <td>@department.ShortDescription</td>
                                    <td>
                                        <a asp-action="EditDepartment" asp-route-id="@department.Id" class="btn btn-sm btn-warning">Edit</a>
                                        <form asp-action="DeleteDepartment" asp-route-id="@department.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>