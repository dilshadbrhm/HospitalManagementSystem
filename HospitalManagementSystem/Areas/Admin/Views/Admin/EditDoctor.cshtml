@model HospitalManagement.Application.Dtos.Admin.AdminDoctorEditDto
@{
    ViewData["Title"] = "Edit Doctor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <h4>Edit Doctor</h4>
    </div>
</div>

<div class="row">
    <div class="col-md-8 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <form asp-action="EditDoctor" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>First Name</label>
                                <input asp-for="FirstName" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Last Name</label>
                                <input asp-for="LastName" class="form-control" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Email</label>
                                <input asp-for="Email" type="email" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Phone</label>
                                <input asp-for="Phone" class="form-control" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Department</label>
                                <select asp-for="DepartmentId" class="form-control" required>
                                    <option value="">Select Department</option>
                                    @foreach (var dept in ViewBag.Departments as IEnumerable<HospitalManagement.Domain.Department>)
                                    {
                                        <option value="@dept.Id">@dept.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Specialization</label>
                                <input asp-for="Specialization" class="form-control" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>License Number</label>
                                <input asp-for="LicenseNumber" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Consultation Fee (AZN)</label>
                                <input asp-for="ConsultationFee" type="number" step="0.01" class="form-control" required />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Bio</label>
                        <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Doctors" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>