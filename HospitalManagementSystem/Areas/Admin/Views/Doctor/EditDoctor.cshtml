@model HospitalManagement.Application.Dtos.Admin.AdminDoctorEditDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Doctor";
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="d-flex justify-content-between align-items-center">
            <h3 class="font-weight-bold">Edit Doctor</h3>
            <a href="/Admin/Home/Doctors" class="btn btn-secondary">
                <i class="mdi mdi-arrow-left"></i> Back
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <form action="/Admin/Home/EditDoctor" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="Id" value="@Model?.Id" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>First Name</label>
                                <input name="FirstName" class="form-control" value="@Model?.FirstName" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Last Name</label>
                                <input name="LastName" class="form-control" value="@Model?.LastName" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Email</label>
                                <input name="Email" type="email" class="form-control" value="@Model?.Email" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Phone</label>
                                <input name="Phone" class="form-control" value="@Model?.Phone" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Department</label>
                                <select name="DepartmentId" class="form-control" required>
                                    <option value="">Select Department</option>
                                    @if (ViewBag.Departments != null)
                                    {
                                        foreach (HospitalManagement.Domain.Department dept in ViewBag.Departments)
                                        {
                                            if (Model != null && dept.Id == Model.DepartmentId)
                                            {
                                                <option value="@dept.Id" selected>@dept.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@dept.Id">@dept.Name</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Specialization</label>
                                <input name="Specialization" class="form-control" value="@Model?.Specialization" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>License Number</label>
                                <input name="LicenseNumber" class="form-control" value="@Model?.LicenseNumber" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Consultation Fee (AZN)</label>
                                <input name="ConsultationFee" type="number" step="0.01" class="form-control" value="@Model?.ConsultationFee" required />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Bio</label>
                        <textarea name="Bio" class="form-control" rows="3">@Model?.Bio</textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Profile Image</label>
                                <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Current Image</label>
                                @if (!string.IsNullOrEmpty(Model?.ProfilePicture))
                                {
                                    <div>
                                        <img src="@Model.ProfilePicture" alt="Doctor" style="max-width: 150px; border-radius: 10px;" />
                                    </div>
                                }
                                else
                                {
                                    <p style="color: #999;">No image</p>
                                }
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Update Doctor</button>
                    <a href="/Admin/Home/Doctors" class="btn btn-light">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>