@model IEnumerable<HospitalManagement.Domain.Entities.BlogCategory>
@{
    ViewData["Title"] = "Blog Categories";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Blog Categories</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add Category
    </a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Description</th>
                    <th>Blog Count</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 1;
                }
                @foreach (HospitalManagement.Domain.Entities.BlogCategory category in Model)
                {
                    int blogCount = category.Blogs != null ? category.Blogs.Count() : 0;
                    <tr>
                        <td>@index</td>
                        <td>@category.Name</td>
                        <td><code>@category.Slug</code></td>
                        <td>@(category.Description ?? "-")</td>
                        <td><span class="badge badge-info">@blogCount</span></td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@category.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure? All blogs in this category will be affected.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <p class="text-muted">No categories found. Create your first category!</p>
            </div>
        }
    </div>
</div>