@model HospitalManagement.Application.Dtos.Admin.AdminDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Dashboard - Hospital Admin</title>
    <link rel="stylesheet" href="/admin/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="/admin/vendors/base/vendor.bundle.base.css">
    <link rel="stylesheet" href="/admin/css/style.css">
</head>
<body>
    <div class="container-scroller">
        <!-- Navbar -->
        <nav class="navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
            <div class="navbar-brand-wrapper d-flex justify-content-center">
                <div class="navbar-brand-inner-wrapper d-flex justify-content-between align-items-center w-100">
                    <a class="navbar-brand brand-logo" href="/Admin">
                        <span style="font-size: 18px; font-weight: bold; color: #fff;">Hospital Admin</span>
                    </a>
                    <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                        <span class="mdi mdi-sort-variant"></span>
                    </button>
                </div>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-center justify-content-end">
                <ul class="navbar-nav navbar-nav-right">
                    <li class="nav-item nav-profile dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" id="profileDropdown">
                            <span class="nav-profile-name">Admin</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="profileDropdown">
                            <a class="dropdown-item" href="/Account/Logout">
                                <i class="mdi mdi-logout text-primary"></i> Logout
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
        </nav>

        <div class="container-fluid page-body-wrapper">
            <!-- Sidebar -->
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/Admin">
                            <i class="mdi mdi-home menu-icon"></i>
                            <span class="menu-title">Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Admin/Home/Doctors">
                            <i class="mdi mdi-doctor menu-icon"></i>
                            <span class="menu-title">Doctors</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Admin/Home/Patients">
                            <i class="mdi mdi-account-multiple menu-icon"></i>
                            <span class="menu-title">Patients</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Admin/Home/Departments">
                            <i class="mdi mdi-hospital-building menu-icon"></i>
                            <span class="menu-title">Departments</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Admin/Home/Appointments">
                            <i class="mdi mdi-calendar-check menu-icon"></i>
                            <span class="menu-title">Appointments</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Main Content -->
            <div class="main-panel">
                <div class="content-wrapper">
                    <div class="row">
                        <div class="col-md-12 grid-margin">
                            <div class="d-flex justify-content-between align-items-center">
                                <h3 class="font-weight-bold">Dashboard</h3>
                            </div>
                        </div>
                    </div>

                    <!-- Stats Cards -->
                    <div class="row">
                        <div class="col-md-4 grid-margin stretch-card">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h4 class="font-weight-bold mb-0">@(Model?.DoctorCount ?? 0)</h4>
                                            <p class="mb-0">Total Doctors</p>
                                        </div>
                                        <i class="mdi mdi-doctor icon-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 grid-margin stretch-card">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h4 class="font-weight-bold mb-0">@(Model?.PatientCount ?? 0)</h4>
                                            <p class="mb-0">Total Patients</p>
                                        </div>
                                        <i class="mdi mdi-account-multiple icon-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 grid-margin stretch-card">
                            <div class="card bg-warning text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h4 class="font-weight-bold mb-0">@(Model?.DepartmentCount ?? 0)</h4>
                                            <p class="mb-0">Departments</p>
                                        </div>
                                        <i class="mdi mdi-hospital-building icon-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 grid-margin stretch-card">
                            <div class="card bg-info text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h4 class="font-weight-bold mb-0">@(Model?.AppointmentCount ?? 0)</h4>
                                            <p class="mb-0">Total Appointments</p>
                                        </div>
                                        <i class="mdi mdi-calendar-check icon-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 grid-margin stretch-card">
                            <div class="card bg-danger text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h4 class="font-weight-bold mb-0">@(Model?.PendingAppointmentCount ?? 0)</h4>
                                            <p class="mb-0">Pending Appointments</p>
                                        </div>
                                        <i class="mdi mdi-clock-outline icon-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 grid-margin stretch-card">
                            <div class="card bg-secondary text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h4 class="font-weight-bold mb-0">@(Model?.TodayAppointmentCount ?? 0)</h4>
                                            <p class="mb-0">Today's Appointments</p>
                                        </div>
                                        <i class="mdi mdi-calendar-today icon-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <footer class="footer">
                    <div class="d-sm-flex justify-content-center">
                        <span class="text-muted text-center">Hospital Management System © 2024</span>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <script src="/admin/vendors/base/vendor.bundle.base.js"></script>
    <script src="/admin/js/off-canvas.js"></script>
    <script src="/admin/js/hoverable-collapse.js"></script>
    <script src="/admin/js/template.js"></script>
</body>
</html>
