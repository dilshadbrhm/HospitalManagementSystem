@model HospitalManagement.Application.Dtos.Admin.AdminDto
@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="d-flex justify-content-between flex-wrap">
            <div class="d-flex align-items-end flex-wrap">
                <div class="me-md-3 me-xl-5">
                    <h2>Welcome back, Admin</h2>
                    <p class="mb-md-0">Hospital Management Dashboard</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0">@Model.DoctorCount</h4>
                        <p class="mb-0">Doctors</p>
                    </div>
                    <i class="mdi mdi-doctor icon-lg"></i>
                </div>
                <a asp-action="Doctors" class="text-white" style="text-decoration: underline;">View All</a>
            </div>
        </div>
    </div>

    <div class="col-md-3 grid-margin stretch-card">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0">@Model.PatientCount</h4>
                        <p class="mb-0">Patients</p>
                    </div>
                    <i class="mdi mdi-account-multiple icon-lg"></i>
                </div>
                <a asp-action="Patients" class="text-white" style="text-decoration: underline;">View All</a>
            </div>
        </div>
    </div>

    <div class="col-md-3 grid-margin stretch-card">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0">@Model.DepartmentCount</h4>
                        <p class="mb-0">Departments</p>
                    </div>
                    <i class="mdi mdi-hospital-building icon-lg"></i>
                </div>
                <a asp-action="Departments" class="text-white" style="text-decoration: underline;">View All</a>
            </div>
        </div>
    </div>

    <div class="col-md-3 grid-margin stretch-card">
        <div class="card bg-danger text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0">@Model.AppointmentCount</h4>
                        <p class="mb-0">Appointments</p>
                    </div>
                    <i class="mdi mdi-calendar-check icon-lg"></i>
                </div>
                <a asp-action="Appointments" class="text-white" style="text-decoration: underline;">View All</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Today's Statistics</h4>
                <div class="d-flex justify-content-between mt-3">
                    <div>
                        <p class="mb-0 text-muted">Today's Appointments</p>
                        <h4>@Model.TodayAppointmentCount</h4>
                    </div>
                    <div>
                        <p class="mb-0 text-muted">Pending Appointments</p>
                        <h4>@Model.PendingAppointmentCount</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Quick Actions</h4>
                <div class="mt-3">
                    <a asp-action="CreateDoctor" class="btn btn-primary me-2">Add Doctor</a>
                    <a asp-action="CreateDepartment" class="btn btn-warning me-2">Add Department</a>
                    <a asp-action="Appointments" class="btn btn-info">View Appointments</a>
                </div>
            </div>
        </div>
    </div>
</div>
