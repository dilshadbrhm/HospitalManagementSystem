@model List<HospitalManagement.Domain.Entities.Notification>
@{
    ViewData["Title"] = "My Notifications";

    if (User.IsInRole("Doctor"))
    {
        Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    }
    else if (User.IsInRole("Patient"))
    {
        Layout = "~/Views/Shared/_PatientLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>My Notifications</h4>
    @if (Model != null && Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllAsRead" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-check-double"></i> Mark All as Read
            </button>
        </form>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="d-flex align-items-start p-3 @(item.IsRead ? "" : "bg-light")" style="border-bottom: 1px solid #eee;">
                    <div class="mr-3">
                        @if (item.Type == "Appointment")
                        {
                            <i class="fas fa-calendar-check text-primary" style="font-size: 24px;"></i>
                        }
                        else if (item.Type == "Lab")
                        {
                            <i class="fas fa-flask text-success" style="font-size: 24px;"></i>
                        }
                        else if (item.Type == "Prescription")
                        {
                            <i class="fas fa-prescription text-info" style="font-size: 24px;"></i>
                        }
                        else
                        {
                            <i class="fas fa-bell text-warning" style="font-size: 24px;"></i>
                        }
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-1">
                            @item.Title
                            @if (!item.IsRead)
                            {
                                <span class="badge badge-primary ml-2">New</span>
                            }
                        </h6>
                        <p class="mb-1 text-muted">@item.Message</p>
                        <small class="text-muted">@item.SentAt.ToString("dd.MM.yyyy HH:mm")</small>
                    </div>
                    <div>
                        @if (!item.IsRead)
                        {
                            <form asp-action="MarkAsRead" asp-route-id="@item.Id" method="post" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success" title="Mark as Read">
                                    <i class="fas fa-check"></i>
                                </button>
                            </form>
                        }
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display: inline;" onsubmit="return confirm('Delete?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-bell-slash text-muted" style="font-size: 48px;"></i>
                <p class="text-muted mt-3">No notifications yet</p>
            </div>
        }
    </div>
</div>