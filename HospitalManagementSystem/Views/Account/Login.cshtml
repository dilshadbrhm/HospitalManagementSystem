@model HospitalManagement.Application.Dtos.Account.LoginDto

<main class="main-content">
    <div class="breadcrumb-area breadcrumb-height" data-bg-image="assets/image/banner/home-1-banner-1.jpg">
        <div class="container h-100">
            <div class="row h-100">
                <div class="col-lg-12">
                    <div class="breadcrumb-item">
                        <h2 class="breadcrumb-heading">Login Page</h2>
                        <ul>
                            <li>
                                <a asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li>Login</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="login-register-area section-space-y-axis-100">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6 pt-5 pt-lg-0">
                    <form method="post">
                        <div class="login-form">
                            <h4 class="login-title">Login</h4>
                            <div class="row">
                                <div class="col-md-12 col-12">
                                    <label asp-for="Email">Email</label>
                                    <input asp-for="Email" placeholder="Enter your email" />
                                    <span class="text-danger" asp-validation-for="Email"></span>
                                </div>

                                <div class="col-md-12 col-12">
                                    <label asp-for="Password">Password</label>
                                    <input asp-for="Password" type="password" placeholder="Enter your password" />
                                    <span class="text-danger" asp-validation-for="Password"></span>
                                </div>

                                <div class="col-md-6 col-12 d-flex">
                                    <input asp-for="RememberMe" />
                                    <label asp-for="RememberMe" class="ms-2">Remember me</label>
                                </div>

                                <div class="col-12">
                                    <button type="submit" class="theme-btn">Login</button>
                                </div>

                                <div class="col-12 mt-3">
                                    <p>Don't have an account? <a asp-action="Register">Register here</a></p>
                                </div>

                                <div class="text-danger" asp-validation-summary="ModelOnly"></div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>