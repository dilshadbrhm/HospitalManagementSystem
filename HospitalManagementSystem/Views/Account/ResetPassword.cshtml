@model HospitalManagement.Application.Dtos.Account.ResetPasswordDto

<main class="main-content">
    <div class="breadcrumb-area breadcrumb-height" data-bg-image="assets/image/banner/home-1-banner-1.jpg">
        <div class="container h-100">
            <div class="row h-100">
                <div class="col-lg-12">
                    <div class="breadcrumb-item">
                        <h2 class="breadcrumb-heading">Reset Password</h2>
                        <ul>
                            <li>
                                <a asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li>Reset Password</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="login-register-area section-space-y-axis-100">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <form method="post">
                        <div class="login-form">
                            <h4 class="login-title">Reset Password</h4>

                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="Token" />

                            <div class="row">
                                <div class="col-12">
                                    <label asp-for="NewPassword">New Password</label>
                                    <input asp-for="NewPassword" type="password" placeholder="New Password" />
                                    <span class="text-danger" asp-validation-for="NewPassword"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="ConfirmPassword">Confirm Password</label>
                                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" />
                                    <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                                </div>

                                <div class="col-12">
                                    <button type="submit" class="theme-btn">Reset Password</button>
                                </div>

                                <div class="text-danger" asp-validation-summary="ModelOnly"></div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>
