@model HospitalManagement.Application.Dtos.Account.ForgotPasswordDto

<main class="main-content">
    <div class="breadcrumb-area breadcrumb-height" data-bg-image="assets/image/banner/home-1-banner-1.jpg">
        <div class="container h-100">
            <div class="row h-100">
                <div class="col-lg-12">
                    <div class="breadcrumb-item">
                        <h2 class="breadcrumb-heading">Forgot Password</h2>
                        <ul>
                            <li>
                                <a asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li>Forgot Password</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="login-register-area section-space-y-axis-100">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <form method="post">
                        <div class="login-form">
                            <h4 class="login-title">Forgot Password</h4>
                            <p>Enter your email and we'll send you a link to reset your password.</p>

                            <div class="row">
                                <div class="col-12">
                                    <label asp-for="Email">Email</label>
                                    <input asp-for="Email" placeholder="Enter your email" />
                                    <span class="text-danger" asp-validation-for="Email"></span>
                                </div>

                                <div class="col-12">
                                    <button type="submit" class="theme-btn">Send Reset Link</button>
                                </div>

                                <div class="col-12 mt-3">
                                    <a asp-action="Login">Back to Login</a>
                                </div>

                                <div class="text-danger" asp-validation-summary="ModelOnly"></div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>