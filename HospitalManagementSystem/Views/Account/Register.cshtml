@model HospitalManagement.Application.Dtos.Account.RegisterDto

<main class="main-content">
    <div class="breadcrumb-area breadcrumb-height" data-bg-image="assets/image/banner/home-1-banner-1.jpg">
        <div class="container h-100">
            <div class="row h-100">
                <div class="col-lg-12">
                    <div class="breadcrumb-item">
                        <h2 class="breadcrumb-heading">Register Page</h2>
                        <ul>
                            <li>
                                <a asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li>Register</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="login-register-area section-space-y-axis-100">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6 pt-5 pt-lg-0">
                    <form method="post">
                        <div class="login-form">
                            <h4 class="login-title">Register</h4>
                            <div class="row">
                                <div class="col-md-6 col-12">
                                    <label asp-for="FirstName">First Name</label>
                                    <input asp-for="FirstName" placeholder="First Name" />
                                    <span class="text-danger" asp-validation-for="FirstName"></span>
                                </div>
                                <br />

                                <div class="col-md-6 col-12">
                                    <label asp-for="LastName">Last Name</label>
                                    <input asp-for="LastName" placeholder="Last Name" />
                                    <span class="text-danger" asp-validation-for="LastName"></span>
                                </div>
                                <br />
                                <div class="col-md-12 col-12">
                                    <label asp-for="Email">Email</label>
                                    <input asp-for="Email" placeholder="Email" />
                                    <span class="text-danger" asp-validation-for="Email"></span>
                                </div>
                                <br />
                                <div class="col-md-12 col-12">
                                    <label asp-for="Phone">Phone</label>
                                    <input asp-for="Phone" placeholder="Phone" />
                                    <span class="text-danger" asp-validation-for="Phone"></span>
                                </div>
                                <br />
                                <div class="col-md-12 col-12">
                                    <label asp-for="UserType">User Type</label>
                                    <select asp-for="UserType" id="userTypeSelect">
                                        <option value="" disabled>Select</option>
                                        <option value="Patient">Patient</option>
                                        <option value="Doctor">Doctor</option>
                                    </select>
                                    <span class="text-danger" asp-validation-for="UserType"></span>
                                </div>
                                <br />
                                <div id="doctorFields" style="display: none;">
                                    <div class="col-md-12 col-12">
                                        <label asp-for="DepartmentId">Department</label>
                                        <select asp-for="DepartmentId">
                                            <option value=""disabled>Select Department</option>
                                            @if (ViewBag.Departments != null)
                                            {
                                                @foreach (var dept in ViewBag.Departments as IEnumerable<HospitalManagement.Domain.Department>)
                                                {
                                                    <option value="@dept.Id">@dept.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <br />
                                    <div class="col-md-12 col-12">
                                        <label asp-for="Specialization">Specialization</label>
                                        <input asp-for="Specialization" placeholder="Specialization" />
                                    </div>
                                    <br />
                                    <div class="col-md-12 col-12">
                                        <label asp-for="LicenseNumber">License Number</label>
                                        <input asp-for="LicenseNumber" placeholder="License Number" />
                                    </div>
                                </div>
                                <br />
                                <div class="col-md-6 col-12">
                                    <label asp-for="Password">Password</label>
                                    <input asp-for="Password" type="password" placeholder="Password" />
                                    <span class="text-danger" asp-validation-for="Password"></span>
                                </div>
                                <br />
                                <div class="col-md-6 col-12">
                                    <label asp-for="ConfirmPassword">Confirm Password</label>
                                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" />
                                    <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                                </div>
                                <br />
                                <div class="col-12">
                                    <button type="submit" class="theme-btn">Register</button>
                                </div>
                                <br />
                                <div class="col-12 mt-3">
                                    <p>Already have an account? <a asp-action="Login">Login here</a></p>
                                </div>
                                <br />
                                <div class="text-danger" asp-validation-summary="ModelOnly"></div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        document.getElementById('userTypeSelect').addEventListener('change', function () {
            var doctorFields = document.getElementById('doctorFields');
            if (this.value === 'Doctor') {
                doctorFields.style.display = 'block';
            } else {
                doctorFields.style.display = 'none';
            }
        });
    </script>
}