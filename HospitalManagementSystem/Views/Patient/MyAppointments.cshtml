@model List<HospitalManagement.Application.Dtos.Appointment.AppointmentItemDto>
@{
    ViewData["Title"] = "My Appointments";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-calendar-alt"></i> All Appointments</span>
        <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Book New
        </a>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Doctor</th>
                        <th>Department</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Fee</th>
                        <th>Status</th>
                        <th>Payment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (HospitalManagement.Application.Dtos.Appointment.AppointmentItemDto appointment in Model)
                    {
                        <tr>
                            <td>@appointment.DoctorName</td>
                            <td>@appointment.DepartmentName</td>
                            <td>@appointment.AppointmentDate.ToString("dd MMM yyyy")</td>
                            <td>@appointment.StartTime.ToString(@"hh\:mm") - @appointment.EndTime.ToString(@"hh\:mm")</td>
                            <td>@appointment.Fee AZN</td>
                            <td>
                                @if (appointment.Status == "Completed")
                                {
                                    <span class="badge badge-info">Completed</span>
                                }
                                else if (appointment.Status == "Confirmed")
                                {
                                    <span class="badge badge-success">Confirmed</span>
                                }
                                else if (appointment.Status == "Pending")
                                {
                                    <span class="badge badge-warning">Pending</span>
                                }
                                else if (appointment.Status == "Cancelled")
                                {
                                    <span class="badge badge-danger">Cancelled</span>
                                }
                            </td>
                            <td>
                                @if (appointment.IsPaid)
                                {
                                    <span class="badge badge-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Unpaid</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                <p class="text-muted">You have no appointments yet.</p>
                <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary">Book Your First Appointment</a>
            </div>
        }
    </div>
</div>