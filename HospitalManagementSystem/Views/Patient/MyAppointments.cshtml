@model List<HospitalManagement.Application.Dtos.Appointment.AppointmentItemDto>
@{
    ViewData["Title"] = "My Appointments";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-calendar-alt"></i> All Appointments</span>
        <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Book New
        </a>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Doctor</th>
                        <th>Department</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (HospitalManagement.Application.Dtos.Appointment.AppointmentItemDto appointment in Model)
                    {
                        <tr>
                            <td>@appointment.DoctorName</td>
                            <td>@appointment.DepartmentName</td>
                            <td>@appointment.AppointmentDate.ToString("dd MMM yyyy")</td>
                            <td>@appointment.StartTime.ToString(@"hh\:mm")</td>
                            <td>
                                @if (appointment.Status == "Completed")
                                {
                                    <span class="badge badge-info">Completed</span>
                                }
                                else if (appointment.Status == "Confirmed")
                                {
                                    <span class="badge badge-success">Confirmed</span>
                                }
                                else if (appointment.Status == "Pending")
                                {
                                    <span class="badge badge-warning">Pending</span>
                                }
                                else if (appointment.Status == "Cancelled")
                                {
                                    <span class="badge badge-danger">Cancelled</span>
                                }
                            </td>
                            <td>
                                @if (appointment.Status != "Cancelled" && appointment.Status != "Completed")
                                {
                                    @if (appointment.AppointmentDate.Date > DateTime.Now.Date.AddDays(1))
                                    {
                                        <a asp-controller="Appointment" asp-action="Reschedule" asp-route-id="@appointment.Id" class="btn btn-sm btn-warning" title="Reschedule">
                                            <i class="fas fa-calendar-alt"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#cancelModal@(appointment.Id)" title="Cancel">
                                            <i class="fas fa-times"></i>
                                        </button>

                                        <div class="modal fade" id="cancelModal@(appointment.Id)" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Cancel Appointment</h5>
                                                        <button type="button" class="close" data-dismiss="modal">
                                                            <span>&times;</span>
                                                        </button>
                                                    </div>
                                                    <form asp-controller="Appointment" asp-action="CancelAppointment" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@appointment.Id" />
                                                        <div class="modal-body">
                                                            <p>Are you sure you want to cancel this appointment?</p>
                                                            <p><strong>Doctor:</strong> @appointment.DoctorName</p>
                                                            <p><strong>Date:</strong> @appointment.AppointmentDate.ToString("dd MMM yyyy")</p>
                                                            <p><strong>Time:</strong> @appointment.StartTime.ToString(@"hh\:mm")</p>
                                                            <div class="form-group">
                                                                <label>Cancellation Reason *</label>
                                                                <textarea name="reason" class="form-control" rows="3" required minlength="5"></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                                            <button type="submit" class="btn btn-danger">Cancel Appointment</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Cannot modify (less than 24h)</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                <p class="text-muted">You have no appointments yet.</p>
                <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary">Book Your First Appointment</a>
            </div>
        }
    </div>
</div>