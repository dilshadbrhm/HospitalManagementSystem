@model IEnumerable<HospitalManagement.Domain.LabResult>
@{
    ViewData["Title"] = "My Lab Results";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<h4>My Lab Results</h4>

<div class="card">
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th>Test Name</th>
                    <th>Test Type</th>
                    <th>Doctor</th>
                    <th>Test Date</th>
                    <th>Status</th>
                    <th>Download</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TestName</td>
                            <td>@item.TestType</td>
                            <td>@item.Doctor?.FirstName @item.Doctor?.LastName</td>
                            <td>@item.TestDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.PdfFilePath))
                                {
                                    <span class="badge badge-success">Ready</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Pending</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.PdfFilePath))
                                {
                                    <a asp-action="DownloadLabResult" asp-route-id="@item.Id" class="btn btn-sm btn-success">
                                        <i class="fas fa-download"></i> Download PDF
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Not available yet</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No lab results found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>