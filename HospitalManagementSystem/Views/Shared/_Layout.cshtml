                                    <li class="nav-item"><a class="nav-link" href="product-details.html">Product detail</a></li>
                                    <li class="nav-item"><a class="nav-link" href="shop-cart.html">Cart</a></li>
                                    <li class="nav-item"><a class="nav-link" href="checkout.html">Checkout</a></li>
                                </ul>
                            </li>

                        </ul>
                        <ul class="navbar-nav navbar-mobile right-nav ml-auto ">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link link_hd" href="#"> <i class="fa fa-user"></i> @User.Identity.Name </a>
                                    <ul class="navbar-nav submenu">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                                    <i class="fa fa-cogs"></i> Admin Panel
                                                </a>
                                            </li>
                                        }
                                        @if (User.IsInRole("Doctor"))
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Doctor" asp-action="Cabinet">
                                                    <i class="fa fa-stethoscope"></i> My Cabinet
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Doctor" asp-action="TimeTable">
                                                    <i class="fa fa-clock-o"></i> My Schedule
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Doctor" asp-action="MyProfile">
                                                    <i class="fa fa-user"></i> My Profile
                                                </a>
                                            </li>
                                        }
                                        @if (User.IsInRole("Patient"))
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Patient" asp-action="Dashboard">
                                                    <i class="fa fa-tachometer"></i> My Dashboard
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Patient" asp-action="MyAppointments">
                                                    <i class="fa fa-calendar"></i> My Appointments
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Patient" asp-action="Profile">
                                                    <i class="fa fa-user"></i> My Profile
                                                </a>
                                            </li>
                                        }
                                        <li class="nav-item" style="border-top: 1px solid #eee; margin-top: 5px; padding-top: 5px;">
                                            <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0; text-align: center;">
                                                <button type="submit" class="nav-link" style="background: none; border: none; cursor: pointer; width: 100%; padding: 10px;">
                                                    <i class="fa fa-sign-out"></i> Logout
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link link_hd" asp-controller="Account" asp-action="Login">
                                        <i class="fa fa-sign-in"></i> Login
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link link_hd" asp-controller="Account" asp-action="Register">
                                        <i class="fa fa-user-plus"></i> Register
                                    </a>
                                </li>
                            }


                            <li class="nav-item dropdown">
                                <a class="nav-link" href="#"> <span class="flaticon-search head-icon"></span> </a>

                            <li class="nav-item  dropdown cart_dropdown">
                                <a class="nav-link" href="#"> <span class="flaticon-supermarket head-icon"></span>   </a>
                                <ul class="navbar-nav submenu">
                                    <li>
                                        <div class="cart" id="cart_items">
                                            <div class="product_inside_cart">

                                                <div class="cart_in">
                                                    <img src="~/assets/image/shop/view-product-1.jpg" class="img-fluid" width="50" alt="proimg" />
                                                    <div class="content">
                                                        <h2>Lucien Rectangle</h2>
                                                        <p>$25.00</p>
                                                    </div>
                                                    <div class="close">
                                                        <span class="flaticon-close  sme"></span>
                                                    </div>
                                                </div>
                                                <div class="cart_in">
                                                    <img src="~/assets/image/shop/view-product-1.jpg" class="img-fluid" width="50" alt="proimg" />
                                                    <div class="content">
                                                        <h2>Lucien Rectangle</h2>
                                                        <p>$25.00</p>
                                                    </div>
                                                    <div class="close">
                                                        <span class="flaticon-close  sme"></span>
                                                    </div>
                                                </div>

                                            </div>


                                            <div class="cart_btns_ clearfix">
                                                <button class="theme-btn float-left">Checkout</button>
                                                <button class="theme-btn float-right">Add to cart</button>
                                            </div>

                                        </div>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
