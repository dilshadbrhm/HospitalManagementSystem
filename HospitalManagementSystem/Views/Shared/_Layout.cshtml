                                    <li><a href="#">Orthopedics </a></li>
                                    <li><a href="#">Pulmonary</a></li>
                                </ul>

                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-2 col-sm-6 col-xs-12">
                        <div class="footer-widget two">
                            <h2>LINKS</h2>
                            <div class="footer-text">
                                <ul>
                                    <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                                    <li><a asp-controller="Appointment" asp-action="Create">Appointment</a></li>
                                    <li><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                                    <li><a asp-controller="Doctor" asp-action="Index">Doctors</a></li>
                                    <li><a href="#">Gallery </a></li>
