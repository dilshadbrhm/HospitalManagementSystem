<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="title" content="Hospital Management">
    <meta name="full-screen" content="yes">
    <meta name="theme-color" content="#568701">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>@ViewData["Title"] | Hospital</title>
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/responsive.css">
    <link rel="stylesheet" type="text/css" href="~/assets/fonts/font/flaticon.css">
    <link rel="icon" type="image/png" href="~/assets/image/fav/favicon-32x32.png" sizes="32x32">
    <link rel="icon" type="image/png" href="~/assets/image/fav/favicon-16x16.png" sizes="16x16">

    <style>
        .navbar-nav .submenu {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            border: none;
            padding: 15px 0;
            min-width: 220px;
            animation: fadeIn 0.3s ease;
            display: none;
            position: absolute;
            z-index: 9999;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .navbar-nav .submenu .nav-item {
            padding: 0;
            margin: 0;
            display: block;
            width: 100%;
        }

        .navbar-nav .submenu .nav-link {
            padding: 12px 25px;
            color: #333;
            font-size: 14px;
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
            display: block;
            width: 100%;
        }

            .navbar-nav .submenu .nav-link:hover {
                background: #f8f9fa;
                color: #8bc34b;
                border-left: 3px solid #8bc34b;
                padding-left: 30px;
            }

            .navbar-nav .submenu .nav-link i {
                margin-right: 10px;
                width: 20px;
                text-align: center;
                color: #8bc34b;
            }

        .right-nav .nav-item.dropdown {
            position: relative;
        }

            .right-nav .nav-item.dropdown .submenu {
                position: absolute;
                top: 100%;
                right: 0;
                left: auto;
                min-width: 250px;
                margin-top: 15px;
            }

                .right-nav .nav-item.dropdown .submenu::before {
                    content: '';
                    position: absolute;
                    top: -10px;
                    right: 20px;
                    border-left: 10px solid transparent;
                    border-right: 10px solid transparent;
                    border-bottom: 10px solid #fff;
                }

        .nav-item.dropdown:hover .submenu {
            display: block;
        }

        .navbar-nav .submenu form button.nav-link {
            padding: 12px 25px;
            color: #e74c3c;
            font-size: 14px;
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
            display: block;
            width: 100%;
            text-align: left;
        }

            .navbar-nav .submenu form button.nav-link:hover {
                background: #fef0f0;
                color: #c0392b;
                border-left: 3px solid #e74c3c;
                padding-left: 30px;
            }

        .navbar-nav > .nav-item > .nav-link.link_hd {
            position: relative;
            transition: all 0.3s ease;
        }

            .navbar-nav > .nav-item > .nav-link.link_hd:hover {
                color: #8bc34b;
            }

            .navbar-nav > .nav-item > .nav-link.link_hd::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                width: 0;
                height: 2px;
                background: #8bc34b;
                transition: all 0.3s ease;
                transform: translateX(-50%);
            }

        .navbar-nav > .nav-item:hover > .nav-link.link_hd::after {
            width: 100%;
        }

        .footer-widget .footer-text ul li a:hover {
            color: #8bc34b;
            padding-left: 5px;
        }

        .footer-widget .footer-text ul li a {
            transition: all 0.3s ease;
        }

        .theme-btn {
            transition: all 0.3s ease;
        }

            .theme-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 20px rgba(139, 195, 75, 0.4);
            }

        .alert {
            border-radius: 8px;
            border: none;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
        }
    </style>
</head>
<body class="sbar_color_one">

    <div class="preloader"></div>

    <div class="page-wapper home-page-one">
        <header class="site-header" id="header-one">
            <div class="top-bar">
                <div class="container">
                    <div class="row clearfix">
                        <div class="col-lg-12">
                            <div class="float-left">
                                <p><i class="fa fa-map-marker"></i> Baku, Azerbaijan - Main Street, 123</p>
                            </div>
                            <div class="float-right">
                                <div class="inner-sec">
                                    <ul class="social-media">
                                        <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                                        <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                                        <li><a href="#"><i class="fa fa-instagram"></i></a></li>
                                        <li><a href="#"><i class="fa fa-linkedin"></i></a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="navbar navbar-expand-lg bsnav bsnav-sticky bsnav-sticky-slide">
                <div class="container">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <img src="~/assets/image/default-logo.png" class="img-fluid" alt="Hospital">
                    </a>
                    <button class="navbar-toggler toggler-spring"><span class="navbar-toggler-icon"></span></button>

                    <div class="collapse navbar-collapse">
                        <ul class="navbar-nav navbar-mobile ml-auto mr-auto">
                            <li class="nav-item no-dropdown">
                                <a class="nav-link link_hd" asp-controller="Home" asp-action="Index">Home</a>
                            </li>

                            <li class="nav-item no-dropdown">
                                <a class="nav-link link_hd" asp-controller="Department" asp-action="Index">Departments</a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link link_hd" href="#">Pages</a>
                                <ul class="navbar-nav submenu">
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Home" asp-action="About">
                                            <i class="fa fa-info-circle"></i> About Us
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Home" asp-action="Contact">
                                            <i class="fa fa-envelope"></i> Contact Us
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Doctor" asp-action="Index">
                                            <i class="fa fa-user-md"></i> Our Doctors
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Appointment" asp-action="Create">
                                            <i class="fa fa-calendar-plus-o"></i> Book Appointment
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item no-dropdown">
                                <a class="nav-link link_hd" asp-controller="Blog" asp-action="Index">Blog</a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link link_hd" asp-controller="Shop" asp-action="Index">Shop</a>
                                <ul class="navbar-nav submenu">
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Shop" asp-action="Index">
                                            <i class="fa fa-shopping-bag"></i> All Products
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                            <i class="fa fa-shopping-cart"></i> My Cart
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Checkout" asp-action="Index">
                                            <i class="fa fa-credit-card"></i> Checkout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>

                        <ul class="navbar-nav navbar-mobile right-nav ml-auto">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link link_hd" href="#">
                                        <i class="fa fa-user"></i> @User.Identity.Name
                                    </a>
                                    <ul class="navbar-nav submenu">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                                    <i class="fa fa-cogs"></i> Admin Panel
                                                </a>
                                            </li>
                                        }
                                        @if (User.IsInRole("Doctor"))
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Doctor" asp-action="Cabinet">
                                                    <i class="fa fa-stethoscope"></i> My Cabinet
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Doctor" asp-action="TimeTable">
                                                    <i class="fa fa-clock-o"></i> My Schedule
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Lab" asp-action="Index">
                                                    <i class="fa fa-flask"></i> Lab Results
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Notification" asp-action="Index">
                                                    <i class="fa fa-bell"></i> Notifications
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Doctor" asp-action="MyProfile">
                                                    <i class="fa fa-user"></i> My Profile
                                                </a>
                                            </li>
                                        }
                                        @if (User.IsInRole("Patient"))
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Patient" asp-action="Dashboard">
                                                    <i class="fa fa-tachometer"></i> Dashboard
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Appointment" asp-action="Index">
                                                    <i class="fa fa-calendar"></i> My Appointments
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Patient" asp-action="MyPrescriptions">
                                                    <i class="fa fa-file-text"></i> My Prescriptions
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Patient" asp-action="MyLabResults">
                                                    <i class="fa fa-flask"></i> My Lab Results
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Notification" asp-action="Index">
                                                    <i class="fa fa-bell"></i> Notifications
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Checkout" asp-action="MyOrders">
                                                    <i class="fa fa-shopping-bag"></i> My Orders
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" asp-controller="Patient" asp-action="Profile">
                                                    <i class="fa fa-user"></i> My Profile
                                                </a>
                                            </li>
                                        }
                                        <li class="nav-item" style="border-top: 1px solid #eee; margin-top: 5px; padding-top: 5px;">
                                            <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0;">
                                                <button type="submit" class="nav-link" style="background: none; border: none; cursor: pointer; width: 100%; text-align: left;">
                                                    <i class="fa fa-sign-out"></i> Logout
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link link_hd" asp-controller="Account" asp-action="Login">
                                        <i class="fa fa-sign-in"></i> Login
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link link_hd" asp-controller="Account" asp-action="Register">
                                        <i class="fa fa-user-plus"></i> Register
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                    <span class="flaticon-supermarket head-icon"></span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        @RenderBody()

        <div class="footer home-one">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="footer-widget first">
                            <h2>ABOUT US</h2>
                            <div class="footer-text">
                                <p>We are a leading healthcare provider committed to delivering excellent medical services with compassion and care to our community.</p>
                                <ul class="social-media">
                                    <li><a href="#"><i class="fa fa-facebook-f"></i></a></li>
                                    <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                                    <li><a href="#"><i class="fa fa-instagram"></i></a></li>
                                    <li><a href="#"><i class="fa fa-linkedin"></i></a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-2 col-sm-6 col-xs-12">
                        <div class="footer-widget two">
                            <h2>QUICK LINKS</h2>
                            <div class="footer-text">
                                <ul>
                                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                    <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                                    <li><a asp-controller="Department" asp-action="Index">Departments</a></li>
                                    <li><a asp-controller="Doctor" asp-action="Index">Doctors</a></li>
                                    <li><a asp-controller="Blog" asp-action="Index">Blog</a></li>
                                    <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-2 col-sm-6 col-xs-12">
                        <div class="footer-widget two">
                            <h2>SERVICES</h2>
                            <div class="footer-text">
                                <ul>
                                    <li><a asp-controller="Appointment" asp-action="Create">Book Appointment</a></li>
                                    <li><a asp-controller="Shop" asp-action="Index">Shop</a></li>
                                    <li><a asp-controller="Cart" asp-action="Index">Cart</a></li>

                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="footer-widget third">
                            <h2>CONTACT US</h2>
                            <div class="footer-text">
                                <p><i class="fa fa-map-marker"></i> Baku, Azerbaijan - Main Street, 123</p>
                                <p><i class="fa fa-phone"></i> <a href="tel:+994501234567">(050) 123-4567</a></p>
                                <p><i class="fa fa-envelope"></i> <a href="mailto:info@hospital.com">info@hospital.com</a></p>
                                <p><i class="fa fa-clock-o"></i> Mon - Sat: 9:00 - 18:00</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-last home-one">
            <div class="container">
                <div class="row clearfix">
                    <div class="col-lg-12">
                        <div class="left">
                            <p>© 2026 <span>Hospital Management.</span> All rights reserved.</p>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <a href="#" id="scroll" class="default-bg" style="display: none;"><span></span></a>
    </div>

    <div class="bsnav-mobile">
        <div class="bsnav-mobile-overlay"></div>
        <div class="navbar">
            <button class="navbar-toggler toggler-spring mobile-toggler"><span class="fa fa-close"></span></button>
        </div>
    </div>

    <script src="~/assets/js/jquery-3.3.1.min.js"></script>
    <script src="~/assets/js/popper.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/assets/js/owl.js"></script>
    <script src="~/assets/js/bsnav.min.js"></script>
    <script src="~/assets/js/jquery-ui.js"></script>
    <script src="~/assets/js/SmoothScroll.min.js"></script>
    <script src="~/assets/js/validator.min.js"></script>
    <script src="~/assets/js/appear.js"></script>
    <script src="~/assets/js/script.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>