@model HospitalManagement.Application.Dtos.HomeDto

<main class="main-content">
    <!------main-slider------>
    <section class="main-slider">
        <div class="main-slider-carousel main-slider-one owl-carousel owl-theme">
            <div class="slide" style="background-image: url(/assets/image/heros-medical-malpractice-500x188.jpg)">
                <div class="container text-left">
                    <div class="content">
                        <h1>
                            GIVING CHILDREN<br />
                            <span>THE CARE THEY DESERVE</span>
                        </h1>
                        <div class="text">
                            The bold mission of our Hospital is to bring
                            an end to the burdens of disease, in all its forms.
                        </div>
                        <div class="link-box">
                            <a asp-controller="Department" asp-action="Index" class="theme-btn">DEPARTMENTS</a>
                            <a asp-controller="Home" asp-action="Contact" class="theme-btn btn-dark">GET IN TOUCH</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="slide" style="background-image:url(/assets/image/banner/home-1-banner-2.jpg)">
                <div class="container text-left">
                    <div class="content">
                        <h1>
                            Advanced Medicine,<br />
                            <span>Trusted Care.</span>
                        </h1>
                        <div class="text">
                            We provide world-class healthcare services
                            with compassion and dedication.
                        </div>
                        <div class="link-box">
                            <a asp-controller="Doctor" asp-action="Index" class="theme-btn">OUR DOCTORS</a>
                            <a asp-controller="Appointment" asp-action="Create" class="theme-btn btn-dark">BOOK APPOINTMENT</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="slide" style="background-image:url(/assets/image/banner/home-1-banner-3.jpg)">
                <div class="container text-left">
                    <div class="content">
                        <h1>
                            Enhancing Life,<br />
                            <span>Excelling in Care.</span>
                        </h1>
                        <div class="text">
                            Your health is our priority. Experience the best
                            medical care with our expert team.
                        </div>
                        <div class="link-box">
                            <a asp-controller="Department" asp-action="Index" class="theme-btn">DEPARTMENTS</a>
                            <a asp-controller="Home" asp-action="Contact" class="theme-btn btn-dark">GET IN TOUCH</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!------main-slider------>
    <!-------appointment-section----->
    <section class="appointment_section hm-one">
        <div class="container">
            <div class="appointment_inner">
                <div class="row">
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <div class="appont_sec_inner">
                            <h6>EMERGENCY</h6>
                            <a href="tel:+994501234567">(050) 123-4567</a>
                            <p>Urgent cases are always seen immediately. In the event of an emergency, please call us.</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <div class="appont_sec_inner">
                            <h6>WORK HOURS</h6>
                            <ul>
                                <li>Mon - Thu...............<span>9:00 - 18:00</span></li>
                                <li>Friday.......................<span>9:00 - 17:00</span></li>
                                <li>Saturday.................<span>10:00 - 16:00</span></li>
                                <li>Sunday....................<span>Closed</span></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-12 col-sm-12">
                        <div class="appont_sec_inner">
                            <h6>BOOK AN APPOINTMENT</h6>

                            @if (User.Identity.IsAuthenticated)
                            {
                                <p style="margin-bottom: 15px;">Ready to book your appointment with our expert doctors?</p>
                                <a asp-controller="Appointment" asp-action="Create" class="theme-btn">
                                    BOOK YOUR APPOINTMENT NOW
                                </a>
                            }
                            else
                            {
                                <p style="margin-bottom: 15px;">Please login or register to book an appointment with our doctors.</p>
                                <a asp-controller="Account" asp-action="Login" class="theme-btn">
                                    LOGIN TO BOOK
                                </a>
                                <p style="margin-top: 15px; color: #666;">
                                    Don't have an account?
                                    <a asp-controller="Account" asp-action="Register" style="color: #8bc34b; font-weight: bold;">Register here</a>
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-------appointment-section----->
    <!-------department-section----->
    <section class="department_section hm-one">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="heading clearfix">
                        <h1>OUR <span>DEPARTMENTS</span></h1>
                        <p><a asp-controller="Department" asp-action="Index">VIEW ALL DEPARTMENTS</a></p>
                    </div>
                </div>
            </div>
            <div class="department_inner">
                <div class="row">
                    <div class="col-lg-12">
                        @if (Model.Departments != null && Model.Departments.Any())
                        {
                            @foreach (var department in Model.Departments.Take(6))
                            {
                                <div class="department_icon_content">
                                    <a asp-controller="Department" asp-action="Details" asp-route-id="@department.Id">
                                        <span class="flaticon-brain dep_icon"></span>
                                    </a>
                                    <a asp-controller="Department" asp-action="Details" asp-route-id="@department.Id">
                                        <h2>@department.Name</h2>
                                    </a>
                                    <p>
                                        @if (string.IsNullOrEmpty(department.ShortDescription))
                                        {
                                            @:Expert medical care and treatment
                                        }
                                        else if (department.ShortDescription.Length > 80)
                                        {
                                            @(department.ShortDescription.Substring(0, 80))
                                                            }
                                        else
                                        {
                                            @department.ShortDescription
                                        }
                                    </p>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-center">No departments available</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-------department-section----->
    <!---------welcome-sec--------->
    <section class="welcome_section hme-one" style="background:url(/assets/image/welcome-hme-1-bg.jpg)">
        <div class="container">
            <div class="row">
                <div class="col-lg-6">
                    <div class="welcme_inner">
                        <div class="heading clearfix">
                            <h1>WELCOME TO <span>OUR HOSPITAL</span></h1>
                        </div>
                        <h6>Our mission is to provide first-class healthcare for the local community in a safe, comfortable, and welcoming environment.</h6>
                        <p>In addition to delivering excellent care and service, we want to inspire people to see their health in a new way.</p>
                        <ul>
                            <li><img src="~/assets/image/awards-1.png" class="img-fluid" alt="awards" /></li>
                            <li><img src="~/assets/image/awards-2.png" class="img-fluid" alt="awards" /></li>
                            <li><img src="~/assets/image/awards-3.png" class="img-fluid" alt="awards" /></li>
                            <li><img src="~/assets/image/awards-4.png" class="img-fluid" alt="awards" /></li>
                        </ul>
                        <a asp-controller="Home" asp-action="Contact" class="theme-btn">GET IN TOUCH</a>
                    </div>
                </div>
                <div class="col-lg-6"></div>
            </div>
        </div>
    </section>
    <!---------welcome-sec--------->
    <!-------------DOCTOR TO THE COMMUNITY.--------->
    <section class="doc_community">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="doc_community_text">
                        <h1>DOCTOR TO THE<span> COMMUNITY.</span></h1>
                        <p>We offer extensive medical procedures to outbound and inbound patients.</p>
                    </div>
                    <div class="mak_appointment">
                        <a asp-controller="Appointment" asp-action="Create">MAKE AN APPOINTMENT</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-------------DOCTOR TO THE COMMUNITY.--------->
    <!--------best-doctors-------->
    <section class="best-doctors hme-one">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="heading">
                        <h1>BEST DOCTORS<span> FOR YOU</span></h1>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <div class="owl-carousel owl-theme three-item">
                        @if (Model.Doctors != null && Model.Doctors.Any())
                        {
                            @foreach (var doctor in Model.Doctors.Take(6))
                            {
                                <div class="best-doctor-outer">
                                    <div class="image">
                                        @if (!string.IsNullOrEmpty(doctor.ProfilePicture))
                                        {
                                            <img src="@doctor.ProfilePicture" class="img-fluid" alt="@doctor.FirstName" />
                                        }
                                        else
                                        {
                                            <img src="~/assets/image/doctor-default.jpg" class="img-fluid" alt="doctor" />
                                        }
                                        <a asp-controller="Doctor" asp-action="Profile" asp-route-id="@doctor.Id" class="link"></a>
                                    </div>
                                    <div class="content-inner">
                                        <h2>
                                            <a asp-controller="Doctor" asp-action="Profile" asp-route-id="@doctor.Id">
                                                Dr. @doctor.FirstName @doctor.LastName
                                            </a>
                                        </h2>
                                        <span>@doctor.DepartmentName</span>
                                        <p>@doctor.Specialization</p>
                                        <ul>
                                            <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                                            <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                                            <li><a href="#"><i class="fa fa-linkedin"></i></a></li>
                                        </ul>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <div class="view-more-doctors">
                        <a asp-controller="Doctor" asp-action="Index" class="view-doctors">SEE ALL DOCTORS</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--------best-doctors-------->
    <!-------contact-through----->
    <div class="contact_through">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div class="contact_through_inner">
                        <span class="flaticon-phone-1 icon"></span>
                        <p>
                            Emergency Cases: <br />
                            <a href="tel:+994501234567">(050) 123-4567</a>
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div class="contact_through_inner">
                        <span class="flaticon-placeholder icon"></span>
                        <p>
                            Baku, Azerbaijan <br />
                            Main Street, 123
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div class="contact_through_inner">
                        <span class="flaticon-envelope icon"></span>
                        <p>
                            Email Address<br />
                            <a href="mailto:info@hospital.com">info@hospital.com</a>
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div class="contact_through_inner">
                        <span class="flaticon-calendar icon"></span>
                        <p>
                            <a asp-controller="Appointment" asp-action="Create">
                                Book Online<br />
                                Appointment Now
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-------contact-through----->
</main>