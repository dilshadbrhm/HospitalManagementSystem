@model HospitalManagement.Application.Dtos.HomeDto
@{
    ViewData["Title"] = "About Us";
}

<main class="main-content">
    <!-----------------breadcrumb------------------------>
    <section class="ban-bread-crumb">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">About Us</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </section>
    <!-----------------breadcrumb------------------------>
    <!-----------------welcome_section------------------------>
    <section class="welcome_section hme-one" style="background:url(/assets/image/medifycover.jpg)">
        <div class="container">
            <div class="row">
                <div class="col-lg-6">
                    <div class="welcme_inner">
                        <div class="heading clearfix">
                            <h1>WELCOME TO <span>OUR HOSPITAL</span></h1>
                        </div>
                        <h6>Our mission is to provide first-class healthcare for the local community in a safe, comfortable, and welcoming environment.</h6>
                        <p>In addition to delivering excellent care and service, we want to inspire people to see their health in a new way. More than doctor visits and medical tests, but a lifelong journey of small, manageable steps. These are some of the things we've been recognized for again and again over the years.</p>
                        <ul>
                            <li><img src="~/assets/image/awards-1.png" class="img-fluid" alt="awards"></li>
                            <li><img src="~/assets/image/awards-2.png" class="img-fluid" alt="awards"></li>
                            <li><img src="~/assets/image/awards-3.png" class="img-fluid" alt="awards"></li>
                            <li><img src="~/assets/image/awards-4.png" class="img-fluid" alt="awards"></li>
                        </ul>
                        <a asp-controller="Home" asp-action="Contact" class="theme-btn">GET IN TOUCH</a>
                    </div>
                </div>
                <div class="col-lg-6"></div>
            </div>
        </div>
    </section>
    <!-----------------welcome_section------------------------>
    <!-----------------our mission------------------------>
    <section style="padding: 80px 0; background: #f8f9fa;">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-4">
                    <div style="text-align: center; padding: 30px;">
                        <i class="fa fa-heartbeat" style="font-size: 50px; color: #8bc34b; margin-bottom: 20px;"></i>
                        <h3>Our Mission</h3>
                        <p>To provide exceptional healthcare services with compassion, respect, and integrity to every patient we serve.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4">
                    <div style="text-align: center; padding: 30px;">
                        <i class="fa fa-eye" style="font-size: 50px; color: #8bc34b; margin-bottom: 20px;"></i>
                        <h3>Our Vision</h3>
                        <p>To be the leading healthcare provider in our region, known for excellence in patient care and medical innovation.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4">
                    <div style="text-align: center; padding: 30px;">
                        <i class="fa fa-users" style="font-size: 50px; color: #8bc34b; margin-bottom: 20px;"></i>
                        <h3>Our Values</h3>
                        <p>Compassion, Excellence, Integrity, Teamwork, and Innovation guide everything we do for our patients.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-----------------our mission------------------------>
    <!-----------------statistics------------------------>
    <section style="padding: 60px 0; background: #8bc34b; color: white;">
        <div class="container">
            <div class="row text-center">
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div style="padding: 20px;">
                        <h2 style="font-size: 48px; font-weight: bold; margin-bottom: 10px;">50+</h2>
                        <p style="font-size: 18px; margin: 0;">Expert Doctors</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div style="padding: 20px;">
                        <h2 style="font-size: 48px; font-weight: bold; margin-bottom: 10px;">10K+</h2>
                        <p style="font-size: 18px; margin: 0;">Happy Patients</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div style="padding: 20px;">
                        <h2 style="font-size: 48px; font-weight: bold; margin-bottom: 10px;">15+</h2>
                        <p style="font-size: 18px; margin: 0;">Departments</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div style="padding: 20px;">
                        <h2 style="font-size: 48px; font-weight: bold; margin-bottom: 10px;">20+</h2>
                        <p style="font-size: 18px; margin: 0;">Years Experience</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-----------------statistics------------------------>
    <!-----------------departments------------------------>
    <!-----------------departments------------------------>
    <section class="department_section hm-one">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="heading clearfix">
                        <h1>OUR <span>DEPARTMENTS</span></h1>
                        <p><a asp-controller="Department" asp-action="Index">VIEW ALL DEPARTMENTS</a></p>
                    </div>
                </div>
            </div>
            <div class="department_inner">
                <div class="row">
                    <div class="col-lg-12">
                        @if (Model.Departments != null && Model.Departments.Any())
                        {
                            @foreach (var department in Model.Departments)
                            {
                                <div class="department_icon_content">
                                    <a asp-controller="Department" asp-action="Details" asp-route-id="@department.Id">
                                        <span class="flaticon-heart-2 dep_icon"></span>
                                    </a>
                                    <a asp-controller="Department" asp-action="Details" asp-route-id="@department.Id">
                                        <h2>@department.Name</h2>
                                    </a>
                                    <p>
                                        @if (string.IsNullOrEmpty(department.ShortDescription))
                                        {
                                            @:Expert medical care and treatment...
                                        }
                                        else if (department.ShortDescription.Length > 60)
                                        {
                                            @(department.ShortDescription.Substring(0, 60))
                                                                            }
                                        else
                                        {
                                            @department.ShortDescription
                                        }
                                    </p>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-center">No departments available</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-----------------departments------------------------>
    <!-----------------departments------------------------>
    <!-----------------doc_community------------------------>
    <section class="doc_community">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="doc_community_text">
                        <h1>DOCTOR TO THE<span> COMMUNITY.</span></h1>
                        <p>We offer extensive medical procedures to outbound and inbound patients.</p>
                    </div>
                    <div class="mak_appointment">
                        <a asp-controller="Appointment" asp-action="Create">MAKE AN APPOINTMENT</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-----------------doc_community------------------------>
    <!-------testimonial_sec----->
    <section class="testimonial_sec hm-one">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="heading clearfix">
                        <h1>WHAT <span>CLIENTS SAY</span></h1>
                    </div>
                </div>
            </div>
            <div class="owl-carousel owl-theme two-item">
                <div class="testimonial_content">
                    <p>"The care I received at this hospital was exceptional. The doctors and nurses were professional, caring, and always available to answer my questions. I highly recommend this hospital to anyone in need of medical care."</p>
                    <div class="client_details">
                        <img src="~/assets/image/pp.png" class="img-fluid" alt="test" />
                        <div class="client_in">
                            <h6>Aysel Mammadova</h6>
                            <span>Patient</span>
                        </div>
                    </div>
                </div>
                <div class="testimonial_content">
                    <p>"My family and I are forever grateful for the excellent care provided to my father. The staff went above and beyond to ensure his comfort. Thank you for your dedication and compassion."</p>
                    <div class="client_details">
                        <img src="~/assets/image/pp.png"  class="img-fluid" alt="test" />
                        <div class="client_in">
                            <h6>Farid Huseynov</h6>
                            <span>Patient's Family</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="owl-carousel owl-theme client-carousel">
                <div class="item"><img src="~/assets/image/client/client-hm-1.jpg" class="img-fluid" alt="img" /></div>
                <div class="item"><img src="~/assets/image/client/client-hm-2.jpg" class="img-fluid" alt="img" /></div>
                <div class="item"><img src="~/assets/image/client/client-hm-3.jpg" class="img-fluid" alt="img" /></div>
                <div class="item"><img src="~/assets/image/client/client-hm-4.jpg" class="img-fluid" alt="img" /></div>
                <div class="item"><img src="~/assets/image/client/client-hm-5.jpg" class="img-fluid" alt="img" /></div>
            </div>
        </div>
    </section>
    <!-------testimonial_sec----->
    <!-------contact-through----->
    <div class="contact_through">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div class="contact_through_inner">
                        <span class="flaticon-phone-1 icon"></span>
                        <p>
                            Emergency Cases: <br />
                            <a href="tel:+994501234567">(050) 123-4567</a>
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div class="contact_through_inner">
                        <span class="flaticon-placeholder icon"></span>
                        <p>
                            Baku, Azerbaijan <br />
                            Main Street, 123
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div class="contact_through_inner">
                        <span class="flaticon-envelope icon"></span>
                        <p>
                            Email Address<br />
                            <a href="mailto:info@hospital.com">info@hospital.com</a>
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div class="contact_through_inner">
                        <span class="flaticon-calendar icon"></span>
                        <p>
                            <a asp-controller="Appointment" asp-action="Create">
                                Book Online<br />
                                Appointment Now
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-------contact-through----->
</main>