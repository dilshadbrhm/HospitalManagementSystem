@model HospitalManagement.Application.Dtos.Prescription.PrescriptionDto
@{
    ViewData["Title"] = "Prescription Details";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<div class="row">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-prescription"></i> Prescription Details</span>
                <a asp-action="PrintPrescription" asp-route-id="@Model.Id" class="btn btn-sm btn-success" target="_blank">
                    <i class="fas fa-print"></i> Print
                </a>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-muted">PRESCRIPTION INFO</h6>
                        <p><strong>Date:</strong> @Model.PrescriptionDate.ToString("dd MMMM yyyy")</p>
                        <p>
                            <strong>Status:</strong>
                            @if (Model.ValidUntil.HasValue)
                            {
                                if (Model.ValidUntil.Value < DateTime.Now)
                                {
                                    <span class="badge badge-danger">Expired</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Valid until @Model.ValidUntil.Value.ToString("dd.MM.yyyy")</span>
                                }
                            }
                        </p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted">PATIENT INFO</h6>
                        <p><strong>Patient:</strong> @Model.PatientName</p>
                    </div>
                </div>

                <div class="alert alert-info">
                    <h6><i class="fas fa-stethoscope"></i> Diagnosis</h6>
                    <p class="mb-0">@Model.Diagnosis</p>
                </div>

                <h5 class="mt-4 mb-3"><i class="fas fa-pills"></i> Prescribed Medicines</h5>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="thead-dark">
                            <tr>
                                <th>#</th>
                                <th>Medicine Name</th>
                                <th>Dosage</th>
                                <th>Frequency</th>
                                <th>Duration</th>
                                <th>Instructions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int itemIndex = 1;
                            }
                            @foreach (HospitalManagement.Application.Dtos.Prescription.PrescriptionItemDto item in Model.Items)
                            {
                                <tr>
                                    <td>@itemIndex</td>
                                    <td><strong>@item.MedicineName</strong></td>
                                    <td><span class="badge badge-secondary">@item.Dosage</span></td>
                                    <td>@item.Frequency</td>
                                    <td>@item.Duration days</td>
                                    <td>@(item.Instructions ?? "-")</td>
                                </tr>
                                itemIndex++;
                            }
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="alert alert-warning mt-4">
                        <h6><i class="fas fa-sticky-note"></i> Notes</h6>
                        <p class="mb-0">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="MyPrescriptions" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Prescriptions
            </a>
            <a asp-action="Cabinet" class="btn btn-primary">
                <i class="fas fa-home"></i> Cabinet
            </a>
        </div>
    </div>
</div>