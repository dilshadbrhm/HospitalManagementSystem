@model HospitalManagement.Application.Dtos.Doctor.DoctorCabinetDto
@{
    ViewData["Title"] = "My Cabinet";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<div class="container" style="padding:50px 0;">
    <h2>Welcome, Dr. @Model.DoctorName</h2>
    <p>@Model.Specialization</p>

    <div class="row" style="margin-top:30px;">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h4>Today's Appointments (@Model.TodayAppointments.Count)</h4>
                </div>
                <div class="card-body">
                    @if (Model.TodayAppointments.Any())
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (HospitalManagement.Application.Dtos.Appointment.AppointmentItemDto item in Model.TodayAppointments)
                                {
                                    <tr>
                                        <td>@item.PatientName</td>
                                        <td>@item.StartTime.ToString(@"hh\:mm")</td>
                                        <td>
                                            @if (item.Status == "Pending")
                                            {
                                                <span class="badge badge-warning">Pending</span>
                                            }
                                            else if (item.Status == "Confirmed")
                                            {
                                                <span class="badge badge-success">Confirmed</span>
                                            }
                                            else if (item.Status == "Completed")
                                            {
                                                <span class="badge badge-info">Completed</span>
                                            }
                                            else if (item.Status == "Cancelled")
                                            {
                                                <span class="badge badge-danger">Cancelled</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.Status == "Completed")
                                            {
                                                <a asp-action="WritePrescription" asp-route-appointmentId="@item.Id" class="btn btn-sm btn-info">
                                                    <i class="fas fa-prescription-bottle-alt"></i> Write Rx
                                                </a>
                                            }
                                            else if (item.Status != "Cancelled")
                                            {
                                                <div class="btn-group-vertical">
                                                    <form asp-action="UpdateAppointmentStatus" method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="appointmentId" value="@item.Id" />
                                                        <select name="status" class="form-control form-control-sm mb-1" onchange="this.form.submit()">
                                                            <option value="">Status</option>
                                                            <option value="Confirmed">Confirm</option>
                                                            <option value="Completed">Complete</option>
                                                        </select>
                                                    </form>
                                                    <a asp-action="RescheduleAppointment" asp-route-id="@item.Id" class="btn btn-sm btn-warning mb-1">
                                                        <i class="fas fa-calendar-alt"></i> Reschedule
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#cancelModal@(item.Id)">
                                                        <i class="fas fa-times"></i> Cancel
                                                    </button>
                                                </div>

                                                <div class="modal fade" id="cancelModal@(item.Id)" tabindex="-1">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title">Cancel Appointment</h5>
                                                                <button type="button" class="close" data-dismiss="modal">
                                                                    <span>&times;</span>
                                                                </button>
                                                            </div>
                                                            <form asp-action="CancelAppointment" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="appointmentId" value="@item.Id" />
                                                                <div class="modal-body">
                                                                    <p>Patient: <strong>@item.PatientName</strong></p>
                                                                    <p>Time: <strong>@item.StartTime.ToString(@"hh\:mm")</strong></p>
                                                                    <div class="form-group">
                                                                        <label>Reason for Cancellation *</label>
                                                                        <textarea name="reason" class="form-control" rows="3" required placeholder="e.g., Emergency, illness"></textarea>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                                                    <button type="submit" class="btn btn-danger">Cancel Appointment</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No appointments for today</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h4>Upcoming Appointments (@Model.UpcomingAppointments.Count)</h4>
                </div>
                <div class="card-body">
                    @if (Model.UpcomingAppointments.Any())
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (HospitalManagement.Application.Dtos.Appointment.AppointmentItemDto item in Model.UpcomingAppointments)
                                {
                                    <tr>
                                        <td>@item.PatientName</td>
                                        <td>@item.AppointmentDate.ToString("dd.MM.yyyy")</td>
                                        <td>@item.StartTime.ToString(@"hh\:mm")</td>
                                        <td>
                                            @if (item.Status == "Pending")
                                            {
                                                <span class="badge badge-warning">Pending</span>
                                            }
                                            else if (item.Status == "Confirmed")
                                            {
                                                <span class="badge badge-success">Confirmed</span>
                                            }
                                            else if (item.Status == "Completed")
                                            {
                                                <span class="badge badge-info">Completed</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.Status == "Completed")
                                            {
                                                <a asp-action="WritePrescription" asp-route-appointmentId="@item.Id" class="btn btn-sm btn-info">
                                                    <i class="fas fa-prescription-bottle-alt"></i> Write Rx
                                                </a>
                                            }
                                            else if (item.Status != "Cancelled")
                                            {
                                                <div class="btn-group-vertical">
                                                    <form asp-action="UpdateAppointmentStatus" method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="appointmentId" value="@item.Id" />
                                                        <select name="status" class="form-control form-control-sm mb-1" onchange="this.form.submit()">
                                                            <option value="">Status</option>
                                                            <option value="Confirmed">Confirm</option>
                                                            <option value="Completed">Complete</option>
                                                        </select>
                                                    </form>
                                                    <a asp-action="RescheduleAppointment" asp-route-id="@item.Id" class="btn btn-sm btn-warning mb-1">
                                                        <i class="fas fa-calendar-alt"></i> Reschedule
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#cancelUpcomingModal@(item.Id)">
                                                        <i class="fas fa-times"></i> Cancel
                                                    </button>
                                                </div>

                                                <div class="modal fade" id="cancelUpcomingModal@(item.Id)" tabindex="-1">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title">Cancel Appointment</h5>
                                                                <button type="button" class="close" data-dismiss="modal">
                                                                    <span>&times;</span>
                                                                </button>
                                                            </div>
                                                            <form asp-action="CancelAppointment" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="appointmentId" value="@item.Id" />
                                                                <div class="modal-body">
                                                                    <p>Patient: <strong>@item.PatientName</strong></p>
                                                                    <p>Date: <strong>@item.AppointmentDate.ToString("dd.MM.yyyy")</strong></p>
                                                                    <p>Time: <strong>@item.StartTime.ToString(@"hh\:mm")</strong></p>
                                                                    <div class="form-group">
                                                                        <label>Reason for Cancellation *</label>
                                                                        <textarea name="reason" class="form-control" rows="3" required placeholder="e.g., Emergency, illness, vacation"></textarea>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                                                    <button type="submit" class="btn btn-danger">Cancel Appointment</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No upcoming appointments</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div style="margin-top:20px;">
        <a asp-action="TimeTable" class="btn btn-primary">My Schedule</a>
        <a asp-action="MyPrescriptions" class="btn btn-info">My Prescriptions</a>
    </div>
</div>