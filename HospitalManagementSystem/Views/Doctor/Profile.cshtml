@model HospitalManagement.Application.Dtos.Doctor.DoctorProfileDto
@{
    ViewData["Title"] = "Dr. " + Model.FullName;
}

<section class="ban-bread-crumb">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item"><a href="/Doctor">Doctors</a></li>
                        <li class="breadcrumb-item active">@Model.FullName</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<div class="container" style="padding: 50px 0;">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                    {
                        <img src="@Model.ProfilePicture" alt="@Model.FullName" class="rounded-circle" style="width: 200px; height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?name=@Model.FirstName+@Model.LastName&size=200&background=0D8ABC&color=fff" alt="@Model.FullName" class="rounded-circle" style="width: 200px; height: 200px; object-fit: cover;">
                    }
                    <h3 class="mt-3">Dr. @Model.FullName</h3>
                    <p class="text-muted">@Model.Specialization</p>
                    <p class="text-success font-weight-bold" style="font-size: 24px;">@Model.ConsultationFee AZN</p>
                    <a asp-controller="Appointment" asp-action="Create" asp-route-doctorId="@Model.Id" class="btn btn-primary btn-lg">
                        <i class="fa fa-calendar"></i> Book Appointment
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4>About Doctor</h4>
                </div>
                <div class="card-body">
                    <p>@(Model.Bio ?? "No bio available.")</p>

                    <h5 class="mt-4">Contact Information</h5>
                    <p><i class="fa fa-envelope"></i> @Model.Email</p>
                    <p><i class="fa fa-phone"></i> @Model.Phone</p>

                    <h5 class="mt-4">Department</h5>
                    <p><i class="fa fa-hospital-o"></i> @Model.DepartmentName</p>
                </div>
            </div>

            @if (Model.TimeSlots != null && Model.TimeSlots.Any())
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <h4>Working Hours</h4>
                    </div>
                    <div class="card-body">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Day</th>
                                    <th>Time</th>
                                    <th>Location</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (HospitalManagement.Application.Dtos.Timeslot.TimeSlotDto slot in Model.TimeSlots.Where(t => t.IsAvailable))
                                {
                                    <tr>
                                        <td>@slot.DayName</td>
                                        <td>@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</td>
                                        <td>@slot.Location</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
