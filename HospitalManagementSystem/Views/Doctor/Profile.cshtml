@model HospitalManagement.Application.Dtos.Doctor.DoctorProfileEditDto
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-user-md"></i> Profile Information
            </div>
            <div class="card-body">
                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>First Name</label>
                                <input asp-for="FirstName" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Last Name</label>
                                <input asp-for="LastName" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>
                    <div class="form-group">
                        <label>Phone</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Specialization</label>
                        <input asp-for="Specialization" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Consultation Fee (AZN)</label>
                        <input asp-for="ConsultationFee" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Bio</label>
                        <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Profile Picture</label>
                        <input type="file" name="profileImage" class="form-control" accept="image/*" />
                        <small class="text-muted">Leave empty to keep current picture</small>
                    </div>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                {
                    <img src="@Model.ProfilePicture" alt="Profile" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover;">
                }
                else
                {
                    <img src="/assets/image/doctor-profile-photo.jpg" alt="Profile" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover;">
                }
                <h5 class="mt-3">Dr. @Model.FullName</h5>
                <p class="text-muted">@Model.Specialization</p>
                <p class="text-success font-weight-bold">@Model.ConsultationFee AZN</p>
            </div>
        </div>
    </div>
</div>