@model List<HospitalManagement.Application.Dtos.Doctor.DoctorItemDto>

@{
    ViewData["Title"] = "Our Doctors";
}

<section class="ban-bread-crumb">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="breadcrumb-item active">Our Doctors</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<section class="best-doctors pages">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="heading">
                    <h1>BEST DOCTORS <span>FOR YOU</span></h1>
                </div>
            </div>
        </div>
        <div class="row">
            @if (Model.Count == 0)
            {
                <div class="col-lg-12">
                    <p>No doctors found.</p>
                </div>
            }
            else
            {
                @foreach (var doctor in Model)
                {
                    <div class="col-lg-4">
                        <div class="best-doctor-outer">
                            <div class="image">
                                @if (!string.IsNullOrEmpty(doctor.ProfilePicture))
                                {
                                    <img src="@doctor.ProfilePicture" class="img-fluid" alt="@doctor.FullName" />
                                }
                                else
                                {
                                    <img src="~/assets/image/best-doctors/best-doctors1.jpg" class="img-fluid" alt="@doctor.FullName" />
                                }
                                <a asp-action="Profile" asp-route-id="@doctor.Id" class="link"></a>
                            </div>
                            <div class="content-inner">
                                <h2><a asp-action="Profile" asp-route-id="@doctor.Id">Dr. @doctor.FullName</a></h2>
                                <span>@doctor.Specialization</span>
                                @if (!string.IsNullOrEmpty(doctor.Bio))
                                {
                                    <p>@(doctor.Bio.Length > 100 ? doctor.Bio.Substring(0, 100) + "..." : doctor.Bio)</p>
                                }
                                else
                                {
                                    <p>@doctor.DepartmentName department specialist.</p>
                                }
                                <a asp-action="Profile" asp-route-id="@doctor.Id" class="theme-btn">View Profile</a>
                                <a asp-controller="Appointment" asp-action="DoctorSchedule" asp-route-doctorId="@doctor.Id" class="theme-btn" style="margin-left:10px; background-color:#28a745;">Book Appointment</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>
